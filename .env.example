# Copy to .env and fill in. docker compose reads .env automatically.

# ollama (default, local), openai or anthropic
LLM_PROVIDER=ollama

# Optional for ollama (qwen2.5:7b) and anthropic (claude-opus-5-5).
# Required for openai.
# CHAT_MODEL=

# OpenAI, or any OpenAI-compatible API through OPENAI_BASE_URL
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic
# ANTHROPIC_API_KEY=
